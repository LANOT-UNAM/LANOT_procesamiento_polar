#
# $Id: system.config 65089 2026-01-12 00:05:32Z danw $
#
#  System configuration file, required for both receiving and processing systems.
#  The TeraScan daemon tsched reads this file at startup/restart, and initiates
#  other processing according to what is configured.

[1]
telemetry.name: jpss2db
telemetry.active: yes
passdisk.files: 10
scheduler.type: scheduled
antenna.index: 1
framer.index: 1
fastssd.index: 1
receiver.index: 1
bitsync.index: 1
lo.index: 1

[2]
telemetry.name: jpssdb
telemetry.active: yes
passdisk.files: 10
scheduler.type: scheduled
antenna.index: 1
framer.index: 1
fastssd.index: 1
receiver.index: 1
bitsync.index: 1
lo.index: 1

[3]
telemetry.name: metopsgdb
telemetry.active: no
passdisk.files: 10
scheduler.type: scheduled
antenna.index: 1
framer.index: 1
fastssd.index: 1
receiver.index: 1
bitsync.index: 1
lo.index: 1

[4]
telemetry.name: nppdb
telemetry.active: yes
passdisk.files: 10
scheduler.type: scheduled
antenna.index: 1
framer.index: 1
fastssd.index: 1
receiver.index: 1
bitsync.index: 1
lo.index: 1

[5]
telemetry.name: aquadb
telemetry.active: yes
passdisk.files: 10
antenna.index: 1
receiver.index: 1
bitsync.index: 1
scheduler.type: scheduled
framer.index: 1
fastssd.index: 1
lo.index: 1

[6]
telemetry.name: ahrpt
telemetry.active: yes
passdisk.files: 10
scheduler.type: scheduled
antenna.index: 2
framer.index: 1
fastssd.index: 2
receiver.index: 2
bitsync.index: 2

[framer-1]
framer.device: /dev/pcicd0
framer.type: PCI
framer.channel: 1
framer.ringsize: 3

[framer-2]
framer.device: /dev/pcicd0
framer.type: PCI
framer.channel: 2
framer.ringsize: 3

[antenna-1]
antenna.type: ANT-24-11A
antenna.device: /dev/terascan/muxport1
#antenna.pedestal_num: 1

[antenna-2]
antenna.type: ANT-24-11P
antenna.device: /dev/terascan/muxport1
#antenna.pedestal_num: 1

[lo-1]
lo.device: /dev/terascan/muxport1
lo.type: 12904101
lo.if: 720
terra-1.frequency: 8212.50
aqua-1.frequency: 8160.00
metop-sg-a1 frequency: 7825.00
npp.frequency: 7812.0
noaa-20.frequency: 7812.0
noaa-21.frequency: 7812.0
fy-3d.frequency: 7820.00
fy-3e.frequency: 7860.00
fy-3f.frequency: 7790.00
oceansat-3.frequency: 8300.00

[receiver-1]
receiver.device: /dev/ptyP0
receiver.type: HRD200
receiver.wide_aqua: yes
receiver.ip: 192.168.124.170
receiver.port: 10001

[bitsync-1]
bitsync.device: /dev/ptyP0
bitsync.type: HRD200

[receiver-2]
receiver.device: /dev/ptyP1
receiver.type: LRD200
receiver.ip: 192.168.124.171
receiver.port: 10001

[bitsync-2]
bitsync.device: /dev/ptyP1
bitsync.type: LRD200

[nav-1]
nav.type: fixed

#[tape-1]
#tape.device: /dev/nst0
#tape.model: DLT
#tape.driver: linux

[postproc-1]
postproc.active: no
postproc.assoc_chains: 6
postproc.command: batch_pproc
postproc.when: post
postproc.wait_for:

# Realtime Quicklook
[recvhost-1]
recvhost.name: localhost
recvhost.active: yes
recvhost.bandwidth: 50
recvhost.assoc_chains: 1 2 4 5
recvhost.send_live: yes
recvhost.header: no
recvhost.stream_proc:
recvhost.port: 4935
recvhost.tries: 3

[recvhost-2]
recvhost.name: 132.247.103.146
recvhost.active: yes
recvhost.bandwidth: 50
recvhost.assoc_chains: 5
recvhost.send_live: no
recvhost.stream_proc: rs
recvhost.port: 1480
recvhost.tries: 3

[recvhost-3]
recvhost.name: 132.247.103.146
recvhost.active: yes
recvhost.bandwidth: 50
recvhost.assoc_chains: 1 2 4 6
recvhost.send_live: no
recvhost.stream_proc:
recvhost.port: 1480
recvhost.tries: 3

[archive-1]
archive.active: no
archive.assoc_chains: 1 2 3 4 5 6
tape.index: 1
# archive.directory: used only if tape.index not supplied, e.g., /nexus/data1/archive
# archive.sub_directory: used only if tape.index not supplied, e.g., %yyyy/%mm

[service-1]
service.active: yes
service.command: waitd

[service-2]
service.active: yes
service.command: xrenderbuf

[envdir-1]
variable.name: DATADIR
directory.path: /nexus/data1

[envdir-2]
variable.name: PGSSPOOL
directory.path: /nexus/data1/PGSSPOOL

[envdir-3]
variable.name: PGSWORKDIR
directory.path: /nexus/data1/PGSWORK

[envdir-4]
variable.name: PASSDISKDIR
directory.path: /nexus/data1/passdisk

[system]
tsched.maxsmant: 8192000
tsched.passgap: 180
batch.system: waitd
gps.device: /dev/terascan/muxport3
gps.type: 70162011
gps.index: palisade
tslogs.search: off
ancillary.protocol: https

[ancillary-time]
previous_hours: -500
future_hours: 500

[tsdebug]
tsdebug.active: no
pproc.logs: yes

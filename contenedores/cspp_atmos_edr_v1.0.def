Bootstrap: docker
From: rockylinux:9

%labels
    Author Alejandro Aguilar Sierra - LANOT UNAM
    Description CSPP Enterprise Atmosphere EDR v1.0 (Rocky 9)
    Version 1.0-LANOT

%files
    # Software base (binarios)
    CSPP_VIIRS_ATMOS_V1.0.tar.gz /opt/

%post
    # 1. Repositorios y Dependencias
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf update -y
    dnf install -y wget tar gzip libgfortran which python3 findutils hdf5 bash procps-ng
    dnf clean all && rm -rf /var/cache/dnf

    # 2. Instalación de los Binarios
    cd /opt
    echo "--- Descomprimiendo Binarios ---"
    tar -zxf CSPP_VIIRS_ATMOS_V1.0.tar.gz
    
    # Buscamos la carpeta recién creada (excluyendo archivos y el propio tar)
    # Esto detectará si se llama 'noaa_edr', 'CSPP_ATMOS_1_0' o cualquier variante.
    REAL_FOLDER=$(find . -maxdepth 1 -type d -not -path "." -not -path "./cspp_atmos_edr" | head -n 1 | sed 's|./||')
    
    if [ -n "$REAL_FOLDER" ]; then
        echo "Carpeta detectada: $REAL_FOLDER"
        ln -s "$REAL_FOLDER" cspp_atmos_edr
    else
        echo "ERROR: No se pudo detectar la carpeta de instalación tras el tar."
        ls -la
        exit 1
    fi

    # Limpieza del tar
    rm -f CSPP_VIIRS_ATMOS_V1.0.tar.gz

    # 3. Preparación de Puntos de Montaje
    # Los creamos dentro de la carpeta real para que persistan a través del link
    mkdir -p "/opt/$REAL_FOLDER/static"
    mkdir -p "/opt/$REAL_FOLDER/ancillary"

%environment
    export CSPP_VIIRS_ATMOS_HOME=/opt/cspp_atmos_edr
    # El archivo de entorno se llama cspp_atmos_env.sh
    if [ -f /opt/cspp_atmos_edr/cspp_atmos_env.sh ]; then
        source /opt/cspp_atmos_edr/cspp_atmos_env.sh
    fi

Bootstrap: localimage
# Se parte de la base común, donde viven el registro, la versión menor
# fijada y los repositorios. Hay que construirla antes: ver construir.sh.
From: lanot_base_rocky9.sif

%labels
    Author Alejandro Aguilar Sierra - LANOT UNAM
    Description Polar2Grid v3.2 + LANOT_tools (mapdrawer, geotiff2view, skewt) + MetaGráfica
    Version 3.2-mapdrawer-LANOT
    Base lanot_base_rocky9.sif
    LANOT_tools_commit 094db73109ab3707cb22a9fcf26004060151ce14
    MetaGrafica_commit 89dfe5e018588add00222aabe8660f92e8bc49b7

%help
    Polar2Grid v3.2 con las herramientas de LANOT para adornar las vistas
    (logos, instante, recortes) y para dibujar los Skew-T de los sondeos
    NUCAPS (skewt, que compila su figura con mg de MetaGráfica).

    REQUISITO DE COMPILACIÓN: este .def toma recursos del HOST donde se
    construye. La máquina debe tener:

        /usr/local/share/lanot/gpkg
        /usr/local/share/lanot/logos
        /usr/local/share/lanot/docs/recortes_coordenadas.csv

    Las colortables NO se copian del host: las instala LANOT_tools desde su
    propio repositorio, que es donde están siempre al día.

    Verificación tras compilar:  apptainer test polar2grid_v3.2-mapdrawer.sif

%files
    # El archivo fuente de Polar2Grid (debe estar junto a este .def en el host)
    CSPP_POLAR2GRID_V3.2.tar.gz /opt/

    # Los parches al Satpy del bundle. Van versionados en el repositorio, no
    # embebidos aquí, porque son código y se prueban aparte: ver la cabecera de
    # ese archivo y contenedores/parches/README.md.
    parches/aplicar_parches_satpy.py /opt/

    # Recursos de mapdrawer que no vienen en el repo, descartando los pesados.
    #    Sintaxis: <ruta_en_el_host> <ruta_en_el_contenedor>
    #    Las colortables se omiten a propósito: install.sh copia las del repo a
    #    /usr/local/share/lanot/colortables y sobrescribiría lo que se pusiera
    #    aquí, porque %files se procesa ANTES que %post.
    /usr/local/share/lanot/gpkg /usr/local/share/lanot/gpkg
    /usr/local/share/lanot/logos /usr/local/share/lanot/logos
    /usr/local/share/lanot/docs/recortes_coordenadas.csv /usr/local/share/lanot/docs/recortes_coordenadas.csv

%post
    # Sin esto, un fallo a media receta no detiene la compilación: Apptainer se
    # queda con el código de la ÚLTIMA orden, así que el .sif se generaría con
    # mapdrawer roto y solo se notaría en producción.
    set -e

    # Versión de LANOT_tools que queda dentro de la imagen. Se fija el commit
    # porque el repositorio todavía no tiene etiquetas de versión; en cuanto las
    # tenga, sustituir por --branch <etiqueta>.
    #
    # El pin aparece DOS veces: aquí y en la etiqueta LANOT_tools_commit de
    # %labels, que es lo único que se puede consultar en un .sif ya compilado
    # (apptainer inspect). Hay que moverlas juntas; hasta hoy la etiqueta se
    # quedó en a5d8d98 mientras el pin ya iba en a7c774a.
    #
    # OJO: el clon es de GitHub, no del host. Cambiar LANOT_tools en tahan y
    # recompilar NO actualiza nada — hay que empujar el commit y mover este pin.
    # Se perdió una compilación así el 2026-08-14. Solo las colortables entran
    # por otra vía: los run_*.sh montan /usr/local/share/lanot/colortables del
    # host encima del de la imagen, así que esas sí basta con instalarlas.
    # 094db73: eaa132d partió un f-string en dos renglones, que solo vale desde
    # Python 3.12; aquí el venv es 3.9 y el %post murió en `skewt --help` con
    # SyntaxError. LANOT_tools lo prueba ahora en tests/test_sintaxis_py39.py.
    #
    # Antes iba en eaa132d: el Skew-T emite cada eje con los decimales que pide el papel
    # (2 en x, 4 en y) y las isotermas con 2 puntos: .mg ~19 % más chico y sin
    # el zigzag de las isotermas. La figura sale igual con el pin anterior, solo
    # peor, así que se comprueba abajo. Se perdió una compilación así el
    # 2026-10-01: se empujó el commit y se recompiló sin mover este pin.
    #
    # Antes iba en b37ad84: el 165 GHz se rotula 'Convective Ice (165 GHz)'
    # (5868a3c); con un pin anterior saldría '165 GHz' a secas.
    #
    # Antes iba en 7fc4022: microondas de ATMS (CSPP MiRS) — 'rain_rate', '_tpw_' y los
    # canales de 88 y 165 GHz en product_map, con sus tres CPT. A diferencia del
    # ozono, aquí el JPG SÍ depende del pin: Polar2Grid no escribe la etiqueta
    # `product`, así que con un pin viejo las vistas salen rotuladas "NOAA-21
    # ATMS" a secas. Degrada en silencio; se comprueba abajo.
    #
    # Antes iba en 3d9e6c0: ozono total de OMPS — la entrada 'columnamounto3' de product_map
    # (y 'omps' como sensor). El JPG no la necesita, porque omps_a_geotiff.py
    # escribe la etiqueta `product` en el GeoTIFF; la necesita el pie de foto de
    # la galería, que solo tiene el nombre del archivo. Degrada en silencio con
    # un pin viejo, así que se comprueba abajo.
    #
    # Antes iba en 931ed29: el Lifted Index negativo ya no sale "n/d" en el
    # Skew-T. netCDF4 aplicaba solo el valid_range [0, 1e6] de Stability y lo borraba.
    #
    # Antes iba en bcabcd4: el Skew-T lleva el logo del LANOT junto al título (--no-logo lo
    # quita), dice NOAA-21 en vez de "NOAA", separa el nivel de superficie de
    # NUCAPS del perfil y sale con 3 cuando no hay sondeo que dibujar, que es lo
    # que lee run_polar2grid_edr.sh para no contarlo como error. Todo degrada en
    # silencio con un pin viejo, así que se comprueba abajo.
    #
    # Antes iba en 65e19a7, que trae skewt (termodiagramas Skew-T de los NUCAPS-EDR de HEAP) y los
    # logos vectoriales. Lo demás que entra con él no cambia las vistas de la
    # cadena: el grosor de --layer ya era fracción del ancho con el pin anterior
    # (f50b864), y las banderas de abajo siguen comprobándose.
    #
    # Antes iba en 2df2fbc, que agrega 'cldtoppres' a product_map, que hace falta desde que
    # run_polar2grid_edr.sh pide CldTopPres: con un pin anterior la vista de
    # presión sale bien coloreada —las CPT van montadas— pero rotulada
    # "NOAA-20 VIIRS", sin decir de qué es. Degrada en silencio, como los de
    # abajo. Casi se pierde una compilación así el 2026-08-18: se empujó el
    # commit y se lanzó el build sin mover este pin.
    #
    # Antes iba en 8bc8f69, que agrega --font-bg a geotiff2view: ése es el caso
    # más duro de todos, porque no degrada — las DECORACION de los dos
    # run_polar2grid_*.sh piden la bandera, así que sin recompilar TODAS las
    # vistas mueren con "unrecognized arguments: --font-bg black".
    #
    # Antes iba en edb2253 (metadata.py y los sondeos NUCAPS) y antes en f1d0c60
    # ('cloudtype' en product_map): los dos con el mismo patrón, un cambio que
    # viaja DENTRO del .sif y que un pin viejo deja atrás en silencio. Las CPT
    # son la excepción de siempre: van montadas desde el host, así que ésas se
    # arreglan con git pull + install.sh en tahan, sin tocar la imagen.
    LANOT_TOOLS_COMMIT=094db73109ab3707cb22a9fcf26004060151ce14

    # MetaGráfica: skewt no dibuja pixeles, escribe un .mg y llama a `mg` para
    # compilarlo a SVG/PDF/EPS. Es un binario C++ fuera de pip, así que el venv
    # de LANOT_tools no lo trae y se compila aquí, con el mismo trato que
    # LANOT_tools: clon de GitHub y commit fijo, que también va en %labels. Hace
    # falta uno del 2026-08-30 o posterior: antes, los `rule` no heredaban el
    # estilo del bloque y las isobaras del Skew-T salían negras de 1 pt
    # (LANOT_tools, docs/plan_skewt.md). Sin `mg`, skewt deja el .mg y avisa:
    # degradaría en silencio, por eso se comprueba abajo.
    MG_COMMIT=89dfe5e018588add00222aabe8660f92e8bc49b7

    # Lo que esta receta necesita además de la base: GDAL y el toolchain para
    # compilar las dependencias de pip de LANOT_tools, más git para clonarlo.
    #
    # --setopt=install_weak_deps=False es indispensable: sin él, gdal arrastra
    # como recomendación las rejillas de datum de PROJ de otros países
    # (proj-data-us 319 MB, -au 118, -ca 106, -de 76, -dk 61, -at 15, -nz 14:
    # 709 MB en total). Ninguna se usa para México, y son las culpables de que
    # la imagen pasara de 1.7 a 2.3 GB. El paquete 'proj' base ya trae proj.db,
    # que es lo que necesitan las reproyecciones de la cadena.
    dnf install -y --setopt=install_weak_deps=False \
                   git gcc gcc-c++ make cmake zlib-devel \
                   gdal gdal-devel python3-pip python3-devel

    # Descomprimir e Instalar Polar2Grid
    cd /opt
    echo "--- Descomprimiendo Polar2Grid v3.2 ---"
    tar -zxf CSPP_POLAR2GRID_V3.2.tar.gz
    rm -f CSPP_POLAR2GRID_V3.2.tar.gz
    ln -s polar2grid_v_3_2 polar2grid

    # --- Parches al Satpy que viaja dentro del bundle ---
    #
    # El bundle lleva satpy 0.59.1.dev110 congelado, así que nada de lo que se
    # arregle aguas arriba nos llega hasta Polar2Grid 3.3. Lo que aplicamos y
    # por qué está en la cabecera del propio script, que se versiona en el
    # repositorio y se prueba fuera de aquí (contenedores/parches/README.md).
    #
    # Va ANTES del calentamiento de más abajo para que el __pycache__ se genere
    # ya parcheado: la imagen no se puede reescribir después.
    #
    # El script exige encontrar el texto exacto que espera; si el bundle cambia,
    # sale con 1 diciendo cuál parche y por qué, y con 'set -e' eso tumba la
    # compilación. Es deliberado: un parche aplicado a medias en un lector es
    # justo la clase de fallo que solo se ve en producción.
    echo "--- Parcheando Satpy ---"
    SP=$(dirname "$(dirname "$(/opt/polar2grid/libexec/python_runtime/bin/python \
        -c 'import satpy, os; print(os.path.realpath(satpy.__file__))')")")
    /opt/polar2grid/libexec/python_runtime/bin/python /opt/aplicar_parches_satpy.py "$SP"
    /opt/polar2grid/libexec/python_runtime/bin/python /opt/aplicar_parches_satpy.py "$SP" --verificar

    # Descargar e Instalar LANOT_tools (mapdrawer)
    echo "--- Clonando LANOT_tools en $LANOT_TOOLS_COMMIT ---"
    cd /opt
    git clone https://github.com/asierra/LANOT_tools.git build_lanot
    cd build_lanot
    git checkout "$LANOT_TOOLS_COMMIT"

    # install.sh trae su propio 'set -e' y usa /opt/lanot-tools/venv
    chmod +x install.sh
    ./install.sh

    # Limpieza: el código útil ya quedó en /opt/lanot-tools/src
    cd /opt
    rm -rf build_lanot

    # Compilar e instalar MetaGráfica. Con g++ y no con el clang++ que pide su
    # Makefile, porque g++ ya está para las ruedas de pip. Se instala a mano y
    # no con `make install`: esa regla exige la página de manual, que se genera
    # con pandoc, y aquí no hace falta. La biblioteca lib/*.mg va a la ruta que
    # el binario trae horneada (MG_LIBDIR), por si alguna figura la incluye.
    echo "--- Compilando MetaGráfica en $MG_COMMIT ---"
    git clone https://github.com/asierra/Metagrafica.git build_mg
    cd build_mg
    git checkout "$MG_COMMIT"
    make CXX=g++ -j"$(nproc)" bin/mg
    install -s -m 755 bin/mg /usr/local/bin/mg
    install -d /usr/local/share/metagrafica/lib
    install -m 644 lib/*.mg /usr/local/share/metagrafica/lib/
    cd /opt
    rm -rf build_mg

    # pip guarda las ruedas descargadas y se quedaban dentro de la imagen:
    # 123 MB que no se usan en ningún momento en tiempo de ejecución.
    rm -rf /root/.cache/pip

    # Quitar lo que solo hacía falta para compilar: el toolchain de las
    # dependencias de pip y git, que ya cumplió su papel al clonar. La
    # verificación de más abajo corre DESPUÉS de esto a propósito: si el
    # recorte se lleva algo necesario, la compilación falla aquí y no en
    # producción.
    dnf remove -y gcc gcc-c++ make cmake zlib-devel gdal-devel python3-devel git
    dnf clean all
    rm -rf /var/cache/dnf

    # Inicialización obligatoria del entorno inmutable: se ejercitan los dos
    # runtimes de Python para que descompriman sus bibliotecas y compilen sus
    # __pycache__ mientras la imagen todavía se puede escribir.
    export POLAR2GRID_HOME=/opt/polar2grid
    export PATH=/usr/local/bin:$POLAR2GRID_HOME/bin:$PATH

    echo "--- Inicializando Polar2Grid ---"
    $POLAR2GRID_HOME/bin/polar2grid.sh -h > /dev/null

    # Ambos salen con código 0 en --help (comprobado en una instalación real),
    # así que esto sirve de verificación además de calentamiento: si el venv
    # quedó incompleto, falla el import y el código deja de ser 0.
    echo "--- Inicializando y verificando LANOT_tools ---"
    mapdrawer --help > /dev/null
    geotiff2view --help > /dev/null

    # Las banderas que los run_*.sh dan por sentadas. Comprobarlas aquí, y no
    # solo que --help salga con 0, es lo que atrapa un PIN DESACTUALIZADO: el
    # 2026-08-14 se compiló con un commit anterior a --percentiles y el fallo
    # apareció hasta el renderizado, con "unrecognized arguments". Al agregar
    # una bandera nueva en LANOT_tools que use la cadena, súbela también aquí.
    geotiff2view --help | grep -q -- --percentiles
    geotiff2view --help | grep -q -- --lat-south
    geotiff2view --help | grep -q -- --font-bg
    mapdrawer    --help | grep -q -- --timestamp-pos

    # No todo lo que la cadena da por sentado es una bandera. run_polar2grid_*.sh
    # distingue "sin datos validos" (codigo 3) de "fallo" leyendo el codigo de
    # salida de geotiff2view archivo por archivo; con un pin anterior a eso, la
    # vista vacia se sigue publicando en negro y nadie se entera. La tabla de
    # codigos vive en el epilogo del --help, asi que basta buscarla.
    geotiff2view --help | grep -q -- "0 imagen generada"

    # Skew-T: skewt tiene que arrancar (netCDF4 en el venv) y `mg` tiene que
    # compilar una figura, porque sin él skewt no falla, solo deja el .mg.
    skewt --help > /dev/null
    skewt --help | grep -q -- --no-logo
    test -f /opt/lanot-tools/src/logos/lanot_logo_struct.mg
    /opt/lanot-tools/venv/bin/python -c "import inspect, nucaps_sounding as n; assert 'surface_T' in inspect.getsource(n.read_sounding), 'pin anterior a 88f47c6'"
    skewt --help | grep -q -- "3 sin sondeo que dibujar"
    /opt/lanot-tools/venv/bin/python -c "import inspect, nucaps_sounding as n; assert 'set_auto_mask(False)' in inspect.getsource(n.read_sounding), 'pin anterior a 931ed29: LI negativo sale n/d'"
    /opt/lanot-tools/venv/bin/python -c "import skewt; assert hasattr(skewt.SkewT, 'isotherm'), 'pin anterior a eaa132d: isotermas de 61 puntos'"
    printf 'display_size 2 2\nworld_window 0 1 0 1\npolyline { 0 0  1 1 }\n' > /tmp/prueba_mg.mg
    mg /tmp/prueba_mg.mg /tmp/prueba_mg.svg
    grep -q '<svg' /tmp/prueba_mg.svg
    rm -f /tmp/prueba_mg.mg /tmp/prueba_mg.svg

    # Tampoco es bandera el mapa de nombres de metadata.py, que es lo ÚNICO de
    # la vista de sondeos que viaja dentro del .sif —las CPT van montadas desde
    # el host— y por lo tanto lo único que un pin viejo puede dejar atrás sin
    # que nada falle: la vista saldría bien coloreada y sin decir de qué es.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa21_atms-cris_Temperature_497mb_20260630_184728_wgs84_geo_5km.tif'); assert m['sensor']=='CrIS+ATMS'; assert m['product']=='Temp 500 hPa'"

    # Presion de tope de nube: run_polar2grid_edr.sh la pide desde el
    # 2026-08-18 y su entrada en product_map viaja aqui dentro, asi que un pin
    # anterior a 2df2fbc la deja sin nombre en la etiqueta sin que nada falle.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa20_viirs_CldTopPres_20260817_193624_wgs84_geo_750m.tif'); assert m.get('product')=='Cloud Top Pressure', 'product_map sin cldtoppres: pin viejo? -> %r' % m.get('product'); assert m.get('units')=='hPa'"

    # Ozono total: run_polar2grid_edr.sh lo renderiza desde el 2026-09-22 y la
    # galería lo rotula por nombre de archivo, con product_map. Un pin anterior
    # a 3d9e6c0 lo deja sin nombre en el pie de foto sin que nada falle.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa20_omps_ColumnAmountO3_20260922_200245_wgs84_geo_5km.tif'); assert m.get('product')=='Total Ozone', 'product_map sin columnamounto3: pin viejo? -> %r' % m.get('product'); assert m.get('units')=='DU'"

    # Microondas de MiRS: run_polar2grid_edr.sh los renderiza desde el 2026-09-26
    # y, sin la etiqueta en el GeoTIFF, el rótulo del JPG sale de product_map.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa21_atms_rain_rate_20260926_082141_wgs84_geo_5km.tif'); assert m.get('product')=='Rain Rate', 'product_map sin rain_rate: pin viejo? -> %r' % m.get('product'); assert m.get('sensor')=='ATMS'"
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa21_atms_btemp_165h_20260926_082141_wgs84_geo_5km.tif'); assert m.get('product')=='Convective Ice (165 GHz)', 'product_map con el rótulo viejo del 165 GHz: pin viejo? -> %r' % m.get('product')"

    # omps_a_geotiff.py (el GeoTIFF de ozono, hasta Polar2Grid 3.3) no viaja en
    # la imagen —run_polar2grid_edr.sh lo monta desde el repositorio—, pero corre
    # con el intérprete del bundle y usa estas tres bibliotecas de su runtime.
    # Un bundle que dejara de traer alguna mataría solo al ozono, en silencio.
    /opt/polar2grid/libexec/python_runtime/bin/python3 -c "import rasterio.features, netCDF4, yaml"

    # Verificación de los recursos que usan las herramientas
    test -x /opt/lanot-tools/venv/bin/python
    test -d /usr/local/share/lanot/colortables
    test -d /usr/local/share/lanot/gpkg
    test -d /usr/local/share/lanot/logos
    test -f /usr/local/share/lanot/docs/recortes_coordenadas.csv

    echo "--- Contenedor listo ---"

%environment
    export POLAR2GRID_HOME=/opt/polar2grid
    # Agregamos primero /usr/local/bin para asegurar que mapdrawer y
    # geotiff2view tengan prioridad
    export PATH=/usr/local/bin:$POLAR2GRID_HOME/bin:$PATH

%test
    # apptainer test polar2grid_v3.2-mapdrawer.sif
    #
    # Cada orden va sola, no encadenada con &&: 'set -e' no aborta cuando falla
    # el lado izquierdo de un &&, así que una prueba encadenada imprimiría el
    # error y seguiría de largo dando la impresión de que todo está bien.
    set -e

    # Nota: v3.2 no tiene --list-readers (eso era de la v3.1); -h sí sale con 0
    echo "Polar2Grid:"
    $POLAR2GRID_HOME/bin/polar2grid.sh -h > /dev/null
    echo "  OK"

    echo "mapdrawer:"
    mapdrawer --help > /dev/null
    echo "  OK $(command -v mapdrawer)"

    echo "geotiff2view:"
    geotiff2view --help > /dev/null
    echo "  OK $(command -v geotiff2view)"

    # Banderas que usan los run_*.sh; ver la nota del %post sobre el pin.
    echo "Banderas en uso:"
    geotiff2view --help | grep -q -- --percentiles
    geotiff2view --help | grep -q -- --lat-south
    geotiff2view --help | grep -q -- --font-bg
    mapdrawer    --help | grep -q -- --timestamp-pos

    # No todo lo que la cadena da por sentado es una bandera. run_polar2grid_*.sh
    # distingue "sin datos validos" (codigo 3) de "fallo" leyendo el codigo de
    # salida de geotiff2view archivo por archivo; con un pin anterior a eso, la
    # vista vacia se sigue publicando en negro y nadie se entera. La tabla de
    # codigos vive en el epilogo del --help, asi que basta buscarla.
    geotiff2view --help | grep -q -- "0 imagen generada"

    # Ver la nota del %post: el mapa de nombres de metadata.py es lo único de la
    # vista de sondeos que va dentro de la imagen, y un pin viejo lo deja atrás
    # en silencio.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa21_atms-cris_Temperature_497mb_20260630_184728_wgs84_geo_5km.tif'); assert m['sensor']=='CrIS+ATMS'; assert m['product']=='Temp 500 hPa'"

    # Presion de tope de nube: run_polar2grid_edr.sh la pide desde el
    # 2026-08-18 y su entrada en product_map viaja aqui dentro, asi que un pin
    # anterior a 2df2fbc la deja sin nombre en la etiqueta sin que nada falle.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa20_viirs_CldTopPres_20260817_193624_wgs84_geo_750m.tif'); assert m.get('product')=='Cloud Top Pressure', 'product_map sin cldtoppres: pin viejo? -> %r' % m.get('product'); assert m.get('units')=='hPa'"

    # Ozono total: run_polar2grid_edr.sh lo renderiza desde el 2026-09-22 y la
    # galería lo rotula por nombre de archivo, con product_map. Un pin anterior
    # a 3d9e6c0 lo deja sin nombre en el pie de foto sin que nada falle.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa20_omps_ColumnAmountO3_20260922_200245_wgs84_geo_5km.tif'); assert m.get('product')=='Total Ozone', 'product_map sin columnamounto3: pin viejo? -> %r' % m.get('product'); assert m.get('units')=='DU'"

    # Microondas de MiRS: run_polar2grid_edr.sh los renderiza desde el 2026-09-26
    # y, sin la etiqueta en el GeoTIFF, el rótulo del JPG sale de product_map.
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa21_atms_rain_rate_20260926_082141_wgs84_geo_5km.tif'); assert m.get('product')=='Rain Rate', 'product_map sin rain_rate: pin viejo? -> %r' % m.get('product'); assert m.get('sensor')=='ATMS'"
    /opt/lanot-tools/venv/bin/python -c "from metadata import Metadata; m=Metadata(); m.enrich_from_filename('noaa21_atms_btemp_165h_20260926_082141_wgs84_geo_5km.tif'); assert m.get('product')=='Convective Ice (165 GHz)', 'product_map con el rótulo viejo del 165 GHz: pin viejo? -> %r' % m.get('product')"
    echo "  OK --percentiles, --lat-south, --font-bg, --timestamp-pos, codigos, product_map"

    # Ver la nota del %post: omps_a_geotiff.py usa el runtime del bundle.
    /opt/polar2grid/libexec/python_runtime/bin/python3 -c "import rasterio.features, netCDF4, yaml"
    echo "  OK runtime de Polar2Grid para omps_a_geotiff.py"

    # Ver la nota del %post: sin mg, skewt deja el .mg sin compilar y no falla.
    echo "Skew-T:"
    skewt --help > /dev/null
    skewt --help | grep -q -- --no-logo
    test -f /opt/lanot-tools/src/logos/lanot_logo_struct.mg
    /opt/lanot-tools/venv/bin/python -c "import inspect, nucaps_sounding as n; assert 'surface_T' in inspect.getsource(n.read_sounding), 'pin anterior a 88f47c6'"
    skewt --help | grep -q -- "3 sin sondeo que dibujar"
    /opt/lanot-tools/venv/bin/python -c "import inspect, nucaps_sounding as n; assert 'set_auto_mask(False)' in inspect.getsource(n.read_sounding), 'pin anterior a 931ed29: LI negativo sale n/d'"
    /opt/lanot-tools/venv/bin/python -c "import skewt; assert hasattr(skewt.SkewT, 'isotherm'), 'pin anterior a eaa132d: isotermas de 61 puntos'"
    /opt/lanot-tools/venv/bin/python -c "import skewt, nucaps_sounding, thermo, netCDF4"
    printf 'display_size 2 2\nworld_window 0 1 0 1\npolyline { 0 0  1 1 }\n' > /tmp/prueba_mg.mg
    mg /tmp/prueba_mg.mg /tmp/prueba_mg.svg
    grep -q '<svg' /tmp/prueba_mg.svg
    rm -f /tmp/prueba_mg.mg /tmp/prueba_mg.svg
    echo "  OK skewt $(command -v skewt) (logo, superficie aparte), mg $(command -v mg)"

    # Ver la nota del %post. Se comprueba con el MISMO script que los aplica,
    # para que no haya dos listas de parches que se puedan desincronizar.
    echo "Parches de Satpy:"
    SP=$(dirname "$(dirname "$($POLAR2GRID_HOME/libexec/python_runtime/bin/python \
        -c 'import satpy, os; print(os.path.realpath(satpy.__file__))')")")
    $POLAR2GRID_HOME/libexec/python_runtime/bin/python /opt/aplicar_parches_satpy.py "$SP" --verificar

    echo "venv:"
    /opt/lanot-tools/venv/bin/python --version

    # PROJ: se recortaron las rejillas de países, así que conviene comprobar
    # que la base sigue completa y que una reproyección real funciona.
    echo "PROJ:"
    /opt/lanot-tools/venv/bin/python -c "
from pyproj import Transformer
x, y = Transformer.from_crs('EPSG:4326', 'EPSG:3857', always_xy=True).transform(-99.13, 19.43)
assert abs(x + 11035000) < 5000 and abs(y - 2205000) < 5000, (x, y)
print('  OK reproyección CDMX a Web Mercator')
"

    echo "Recursos:"
    for r in /usr/local/share/lanot/colortables \
             /usr/local/share/lanot/gpkg \
             /usr/local/share/lanot/logos \
             /usr/local/share/lanot/docs/recortes_coordenadas.csv; do
        test -e "$r"
        echo "  OK $r"
    done

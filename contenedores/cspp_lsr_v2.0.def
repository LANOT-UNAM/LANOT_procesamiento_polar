Bootstrap: localimage
# Se parte de la base común, donde viven el registro, la versión menor
# fijada y los repositorios. Hay que construirla antes: ver construir.sh.
From: lanot_base_rocky9.sif

%labels
    Base lanot_base_rocky9.sif
    Author Alejandro Aguilar Sierra - LANOT UNAM
    Description CSPP Land Surface Reflectance (LSR) EDR v2.0 (Rocky 9)
    Version 2.0-LANOT

%files
    # Asegúrate de tener el binario descargado en el mismo directorio del .def
    CSPP_VIIRS_SURFACE_REFLECTANCE_V2.0.tar.gz /opt/

%post
    # Sin esto, un fallo a media receta no detiene la compilación:
    # Apptainer se queda con el código de la ÚLTIMA orden.
    set -e

    # el driver de LSR es un script de perl
    dnf install -y --setopt=install_weak_deps=False perl
    dnf clean all && rm -rf /var/cache/dnf

    # Instalación de los Binarios
    cd /opt
    echo "--- Descomprimiendo Binarios de LSR ---"
    tar -zxf CSPP_VIIRS_SURFACE_REFLECTANCE_V2.0.tar.gz

    # Buscamos la carpeta recién creada 
    REAL_FOLDER=$(find . -maxdepth 1 -type d -not -path "." -not -path "./cspp_lsr" | head -n 1 | sed 's|./||')

    if [ -n "$REAL_FOLDER" ]; then
        echo "Carpeta detectada: $REAL_FOLDER"
        ln -s "$REAL_FOLDER" cspp_lsr
    else
        echo "ERROR: No se pudo detectar la carpeta de instalación tras el tar."
        ls -la
        exit 1
    fi

    # Limpieza del tar para reducir el tamaño del contenedor
    rm -f CSPP_LSR_V2.0.tar.gz

    # 3. Preparación de Puntos de Montaje (Static y Ancillary)
    # Los creamos dentro de la carpeta real para inyectar datos en tiempo de ejecución
    mkdir -p "/opt/$REAL_FOLDER/static"
    mkdir -p "/opt/$REAL_FOLDER/ancillary"

%environment
    export CSPP_LSR_HOME=/opt/cspp_lsr

    # Cargar el entorno de CSPP LSR
    if [ -f /opt/cspp_lsr/cspp_lsr_env.sh ]; then
        source /opt/cspp_lsr/cspp_lsr_env.sh
    fi

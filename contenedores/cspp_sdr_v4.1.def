Bootstrap: docker
From: rockylinux:8

%labels
    Author LANOT - UNAM
    Description CSPP SDR v4.1 (Motor Ligero - Sin Java - Datos montados externamente)
    Version 4.1-LANOT-LIGHT

%files
    # Solo necesitamos el tarball del código
    CSPP_SDR_V4.1.tar.gz /opt/

%post
    # 1. Dependencias Mínimas
    dnf install -y epel-release
    dnf update -y
    dnf install -y wget tar gzip libgfortran which python3
    dnf clean all

    # 2. Instalación del Motor
    cd /opt
    echo "Instalando Motor CSPP SDR..."
    tar -zxf CSPP_SDR_V4.1.tar.gz
    rm -f CSPP_SDR_V4.1.tar.gz
    
    # 3. Crear el enlace simbólico (Esto sigue igual)
    ln -s CSPP_SDR_V4.1 cspp_sdr

    # 4. PREPARAR PUNTOS DE MONTAJE (CORREGIDO)
    # === CORRECCIÓN ===
    # Usamos el nombre REAL del directorio para crear las carpetas, 
    # evitando el error con el enlace simbólico.
    
    REAL_BASE=/opt/CSPP_SDR_V4.1
    
    echo "Creando estructura de carpetas en $REAL_BASE..."

    # VIIRS
    mkdir -p $REAL_BASE/viirs/luts
    mkdir -p $REAL_BASE/viirs/tiles
    
    # Sensores de Sondeo
    mkdir -p $REAL_BASE/atms/luts
    mkdir -p $REAL_BASE/cris/luts
    mkdir -p $REAL_BASE/omps/luts
    
    # Datos Auxiliares
    mkdir -p $REAL_BASE/anc

%environment
    # Aquí sí usamos el enlace simbólico, porque al ejecutar ya no hay problema
    export CSPP_SDR_HOME=/opt/cspp_sdr
    export PATH=$CSPP_SDR_HOME/common:$CSPP_SDR_HOME/viirs/sdr/scripts:$PATH
    export LC_ALL=C


Bootstrap: docker
From: rockylinux:8

%labels
    Author LANOT - UNAM
    Description CSPP SDR v4.1 
    Version 4.1-LANOT-GOLDEN

%files
    CSPP_SDR_V4.1.tar.gz /opt/

%post
    # 1. Dependencias
    dnf install -y epel-release
    
    # En Rocky Linux 8, SZIP está en el repositorio 'powertools'
    dnf config-manager --set-enabled powertools
    
    dnf update -y
    
    # Agregamos findutils y procps-ng por si acaso
    dnf install -y wget tar gzip libgfortran which python3 findutils hdf5
    dnf clean all && \
    rm -rf /var/cache/dnf

    # 2. Instalación
    cd /opt
    echo "--- Descomprimiendo ---"
    tar -zxf CSPP_SDR_V4.1.tar.gz
    rm -f CSPP_SDR_V4.1.tar.gz
    
    # 3. ENLACE SIMBÓLICO 
    if [ -d "SDR_4_1" ]; then
        echo "Directorio SDR_4_1 detectado correctamente."
        ln -s SDR_4_1 cspp_sdr
    else
        echo "ERROR CRÍTICO: No se encontró la carpeta SDR_4_1 tras descomprimir."
        ls -la
        exit 1
    fi
    
    # 4. PREPARAR PUNTOS DE MONTAJE
    # Usamos la ruta real validada
    REAL_BASE=/opt/SDR_4_1
    
    echo "--- Creando carpetas de datos en $REAL_BASE ---"
    # Estructura para datos estáticos
    mkdir -p $REAL_BASE/viirs/luts
    mkdir -p $REAL_BASE/viirs/tiles
    mkdir -p $REAL_BASE/atms/luts
    mkdir -p $REAL_BASE/cris/luts
    mkdir -p $REAL_BASE/omps/luts
    mkdir -p $REAL_BASE/anc
    
    # 5. VERIFICACIÓN FINAL
    echo "--- VERIFICANDO BINARIOS ---"
    ls -l /opt/cspp_sdr/bin/atms_sdr.sh
    if [ -f "/opt/cspp_sdr/bin/atms_sdr.sh" ]; then
        echo "CHECK: ATMS Script encontrado."
    else
        echo "FAIL: No se encontró el script en bin/"
        exit 1
    fi

%environment
    export CSPP_SDR_HOME=/opt/cspp_sdr
    
    # --- AJUSTE VITAL ---
    # Tu tree muestra que los scripts están en /bin
    # Agregamos $CSPP_SDR_HOME/bin AL PRINCIPIO del PATH
    export PATH=$CSPP_SDR_HOME/bin:$PATH
    
    # Mantenemos las rutas legacy por compatibilidad interna de scripts
    export PATH=$CSPP_SDR_HOME/common:$PATH
    export PATH=$CSPP_SDR_HOME/viirs/sdr/scripts:$PATH
    export PATH=$CSPP_SDR_HOME/atms/sdr/scripts:$PATH
    export PATH=$CSPP_SDR_HOME/cris/sdr/scripts:$PATH
    export PATH=$CSPP_SDR_HOME/omps/sdr/scripts:$PATH
    
    export LC_ALL=C

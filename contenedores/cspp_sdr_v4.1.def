Bootstrap: docker
From: rockylinux:8

%labels
    Author LANOT - UNAM
    Description CSPP SDR v4.1 (Procesamiento VIIRS/ATMS/CrIS para NPP/JPSS)
    Version 4.1-LANOT-LIGHT

%files
    # Solo necesitamos el tarball del código (~100MB)
    CSPP_SDR_V4.1.tar.gz /opt/

%post
    # 1. Dependencias Mínimas (CORREGIDO: Sin Java)
    dnf install -y epel-release
    dnf update -y
    # libgfortran: Necesario para los binarios compilados
    # python3: Necesario para los scripts envoltorios (wrapper scripts)
    # which/tar/gzip: Utilerías básicas
    dnf install -y wget tar gzip libgfortran which python3
    dnf clean all

    # 2. Instalación del Motor
    cd /opt
    echo "Instalando Motor CSPP SDR..."
    tar -zxf CSPP_SDR_V4.1.tar.gz
    rm -f CSPP_SDR_V4.1.tar.gz
    
    # Creamos enlace simbólico para estandarizar la ruta
    ln -s CSPP_SDR_V4.1 cspp_sdr

    # 3. PREPARAR PUNTOS DE MONTAJE (CRÍTICO)
    # Creamos las carpetas vacías EXACTAMENTE donde el software las busca.
    # NO borres esto, es vital para que funcionen los --bind.
    
    BASE=/opt/cspp_sdr
    
    # VIIRS (LUTs y Tiles de Terreno)
    mkdir -p $BASE/viirs/luts
    mkdir -p $BASE/viirs/tiles
    
    # Sensores de Sondeo (ATMS, CrIS, OMPS)
    mkdir -p $BASE/atms/luts
    mkdir -p $BASE/cris/luts
    mkdir -p $BASE/omps/luts
    
    # Datos Auxiliares Estáticos (Stray Light y Cache)
    # Según tu anc.tree, tienes datos en /anc/static y /anc/cache
    mkdir -p $BASE/anc

%environment
    export CSPP_SDR_HOME=/opt/cspp_sdr
    export PATH=$CSPP_SDR_HOME/common:$CSPP_SDR_HOME/viirs/sdr/scripts:$PATH
    export LC_ALL=C


Bootstrap: docker
# Se fija la versión menor y se usa el registro de Quay, que es donde Rocky
# mantiene sus imágenes: las de Docker Hub quedaron congeladas (9 en 9.3, 8 en
# 8.9), así que se partía de una base vieja y el 'dnf update' la subía hasta la
# del día de la compilación. Eso hacía que el contenido cambiara solo.
From: quay.io/rockylinux/rockylinux:9.8

%labels
    Base quay.io/rockylinux/rockylinux:9.8

%files
    # El archivo debe estar en la misma carpeta que este .def
    CSPP_POLAR2GRID_V3.2.tar.gz /opt/

%post
    # Sin esto, un fallo a media receta no detiene la compilación:
    # Apptainer se queda con el código de la ÚLTIMA orden.
    set -e

    # 1. Dependencias Base
    # fontconfig y freetype son necesarios internamente por Satpy/matplotlib 
    # para poder dibujar contornos de costas y textos en los GeoTIFF.
    dnf install -y --setopt=install_weak_deps=False tar gzip bash fontconfig freetype
    dnf clean all && rm -rf /var/cache/dnf

    # 2. Descomprimir e Instalar
    cd /opt
    echo "--- Descomprimiendo Polar2Grid v3.2 ---"
    tar -zxf CSPP_POLAR2GRID_V3.2.tar.gz
    rm -f CSPP_POLAR2GRID_V3.2.tar.gz

    # Enlace simbólico para agnósticismo de versión
    ln -s polar2grid_v_3_2 polar2grid

    # 3. Inicialización Obligatoria (El truco del manual)
    # Ejecutamos el helper (-h) para que el runtime de Python descomprima 
    # sus librerías dinámicas antes de que el SIF se vuelva de solo lectura.
    export POLAR2GRID_HOME=/opt/polar2grid
    export PATH=$PATH:$POLAR2GRID_HOME/bin
    
    echo "--- Inicializando entorno inmutable ---"
    $POLAR2GRID_HOME/bin/polar2grid.sh -h

%environment
    export POLAR2GRID_HOME=/opt/polar2grid
    export PATH=$POLAR2GRID_HOME/bin:$PATH

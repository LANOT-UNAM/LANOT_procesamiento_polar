Bootstrap: docker
From: rockylinux:9

%labels
    Author LANOT - UNAM
    Description CSPP EDR
    Version 1.0-LANOT

%files
	cspp-viirs-flood_2.0.tar.gz /opt/
	CSPP_CLAVRX_V3.0.tar.xz /opt/
	
%post
    # 1. Dependencias
    dnf install -y epel-release
    
    # En Rocky Linux 9, el repositorio se llama 'crb', no 'powertools'
    dnf config-manager --set-enabled crb
    
    dnf update -y
    
    # Instalación de herramientas base y librerías
    dnf install -y wget tar gzip libgfortran which python3 findutils hdf5 procps-ng
    dnf clean all && rm -rf /var/cache/dnf
    
    # 2. Instalación de CSPP
    cd /opt
    tar -zxf cspp-viirs-flood_2.0.tar.gz
    rm -f cspp-viirs-flood_2.0.tar.gz
    
    tar xf CSPP_CLAVRX_V3.0.tar.xz
    rm -f CSPP_CLAVRX_V3.0.tar.xz
    
    # 4. PREPARAR PUNTOS DE MONTAJE
    mkdir -p /opt/CLAVRx_3_0/static
    mkdir -p /opt/proc
    
%environment
    export CSPP_VIIRS_FLOOD_HOME=/opt/cspp_viirs_flood_detection_2.0

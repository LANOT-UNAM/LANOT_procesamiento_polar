#!/bin/bash
#SBATCH --job-name=cspp_active_fire
#SBATCH --output=logs/fire_%j.out
#SBATCH --error=logs/fire_%j.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --partition=normal

# ==============================================================================
# LANOT - UNAM | CSPP Active Fire v2.1 (Apptainer)
# ==============================================================================

INPUT_SDR_DIR="/data/output/jpss/level1/viirs"
OUTPUT_DIR="/data/output/jpss/level2/fires"
SIF_IMAGE="/opt/containers/cspp_active_fire_edr.sif"

# Rutas internas basadas en tu contenedor
CONTAINER_HOME="/opt/cspp-active-fire-noaa_2.1"
ENV_SCRIPT="${CONTAINER_HOME}/cspp_active_fire_noaa_env.sh"
EXEC_SCRIPT="${CONTAINER_HOME}/bin/cspp_active_fire_noaa.sh"

JOB_ID=${SLURM_JOB_ID:-$$}
STAGING_DIR="/data/output/jpss/tmp/fire_staging_${JOB_ID}"

mkdir -p "${OUTPUT_DIR}" "${STAGING_DIR}" logs

echo "================================================================="
echo " Iniciando CSPP Active Fire v2.1 | Satélite: ${1:-j01}"
echo " Staging: ${STAGING_DIR}"

# Creamos enlaces simbólicos
ln -s ${INPUT_SDR_DIR}/* ${STAGING_DIR}/ 2>/dev/null

# DEBUG: Verificar si los archivos son visibles desde el contenedor
echo " --- Verificando archivos SDR en /input_data ---"
apptainer exec -B "${STAGING_DIR}":/input_data "${SIF_IMAGE}" ls /input_data | head -n 5

SAT_PLATFORM=${1:-"j01"}

# ==============================================================================
# Ejecución con Apptainer + Sourcing de Entorno
# ==============================================================================
# Usamos bash -c para cargar las variables del software antes de ejecutarlo
apptainer exec \
    --env LC_ALL=C \
    -B "${STAGING_DIR}":/input_data \
    -B "${OUTPUT_DIR}":/output_data \
    -B "/data/output/jpss":"/data/output/jpss" \
    "${SIF_IMAGE}" \
    /bin/bash -c "source ${ENV_SCRIPT} && ${EXEC_SCRIPT} -i /input_data -o /output_data -p ${SAT_PLATFORM} -v"

EXIT_CODE=$?

echo "================================================================="
rm -rf "${STAGING_DIR}"
echo " Fin del proceso. Código: ${EXIT_CODE}"
echo "================================================================="

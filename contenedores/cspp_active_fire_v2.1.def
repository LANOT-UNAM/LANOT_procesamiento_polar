Bootstrap: docker
# Se fija la versión menor y se usa el registro de Quay, que es donde Rocky
# mantiene sus imágenes: las de Docker Hub quedaron congeladas (9 en 9.3, 8 en
# 8.9), así que se partía de una base vieja y el 'dnf update' la subía hasta la
# del día de la compilación. Eso hacía que el contenido cambiara solo.
From: quay.io/rockylinux/rockylinux:9.8

%labels
    Base quay.io/rockylinux/rockylinux:9.8
    Author Alejandro Aguilar Sierra - LANOT UNAM
    Description CSPP VIIRS Active Fire Software Version 2.1 (Rocky 9)
    Version 2.1-LANOT

%files
    cspp-active-fire-noaa_2.1.tar.gz /opt/

%post
    # Sin esto, un fallo a media receta no detiene la compilación:
    # Apptainer se queda con el código de la ÚLTIMA orden.
    set -e

    # 1. Repositorios y Dependencias
    dnf install -y --setopt=install_weak_deps=False epel-release
    dnf config-manager --set-enabled crb
    
    # Dependencias comunes para binarios de CSPP (HDF5, libgfortran, etc.)
    dnf install -y --setopt=install_weak_deps=False wget tar gzip libgfortran which python3 findutils hdf5 bash procps-ng
    dnf clean all && rm -rf /var/cache/dnf

    # 2. Instalación de los Binarios
    cd /opt
    echo "--- Descomprimiendo Binarios de Active Fire ---"
    tar -zxf cspp-active-fire-noaa_2.1.tar.gz
    
    # Según el manual, se crea la carpeta cspp-active-fire-noaa_2.1 [cite: 74]
    REAL_FOLDER="cspp-active-fire-noaa_2.1"
    
    if [ -d "$REAL_FOLDER" ]; then
        echo "Carpeta detectada: $REAL_FOLDER"
        # Enlace simbólico genérico para facilitar las rutas en scripts
        ln -s "$REAL_FOLDER" cspp_active_fire
    else
        echo "ERROR: No se encontró la carpeta $REAL_FOLDER tras la extracción."
        ls -la
        exit 1
    fi

    # Limpieza del tarball para reducir el tamaño de la imagen
    rm -f cspp-active-fire-noaa_2.1.tar.gz

%environment
    # 3. Configuración de Variables de Entorno [cite: 74, 75]
    export CSPP_ACTIVE_FIRE_HOME="/opt/cspp_active_fire"
    export PATH="$CSPP_ACTIVE_FIRE_HOME:$PATH"
    if [ -f /opt/cspp_active_fire/cspp_active_fire_noaa_env.sh ]; then
        source /opt/cspp_active_fire/cspp_active_fire_noaa_env.sh
    fi 

#!/bin/bash
#SBATCH --job-name=cspp_active_fire
#SBATCH --output=logs/fire_%j.out
#SBATCH --error=logs/fire_%j.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --partition=normal

# ==============================================================================
# LANOT - UNAM | CSPP Active Fire v2.1 (Apptainer)
# ==============================================================================

# --- Rutas de Datos y Software ---
INPUT_SDR_DIR="/data/output/jpss/level1/viirs"
OUTPUT_DIR="/data/output/jpss/level2/fires"
SIF_IMAGE="/opt/containers/cspp_active_fire_edr.sif"

# --- Configuración de Rutas Internas ---
CONTAINER_APP_HOME="/opt/cspp-active-fire-noaa_2.1"
CONTAINER_EXECUTABLE="${CONTAINER_APP_HOME}/bin/cspp_active_fire_noaa.sh"

# --- Directorio Temporal (Staging) ---
JOB_ID=${SLURM_JOB_ID:-$$}
STAGING_DIR="/data/output/jpss/tmp/fire_staging_${JOB_ID}"

# --- Preparación del Entorno ---
mkdir -p "${OUTPUT_DIR}"
mkdir -p "${STAGING_DIR}"
mkdir -p logs

echo "================================================================="
echo " Iniciando CSPP Active Fire v2.1 a las $(date)"
echo " Preparando staging en: ${STAGING_DIR}"

# Enlazamos los archivos de nivel 1
ln -s ${INPUT_SDR_DIR}/* ${STAGING_DIR}/ 2>/dev/null

# Verificamos si se crearon enlaces
FILE_COUNT=$(ls -1 "${STAGING_DIR}" | wc -l)
echo " Archivos en staging: ${FILE_COUNT}"

if [ "$FILE_COUNT" -eq 0 ]; then
    echo " ERROR: No hay archivos para procesar en ${INPUT_SDR_DIR}"
    rm -rf "${STAGING_DIR}"
    exit 1
fi

# Definimos el satélite (por defecto j02 si no se pasa como primer argumento)
SAT_PLATFORM=${1:-"j02"}

echo " Procesando plataforma: ${SAT_PLATFORM}"
echo "================================================================="

# ==============================================================================
# Ejecución con Apptainer
# ==============================================================================
# Agregamos -v para ver el log detallado del software
apptainer exec \
    --env LC_ALL=C \
    --env CSPP_ACTIVE_FIRE_HOME="${CONTAINER_APP_HOME}" \
    -B "${STAGING_DIR}":/input_data \
    -B "${OUTPUT_DIR}":/output_data \
    -B "/data/output/jpss":"/data/output/jpss" \
    "${SIF_IMAGE}" \
    "${CONTAINER_EXECUTABLE}" \
    -i /input_data \
    -o /output_data \
    -p "${SAT_PLATFORM}" \
    -v \
    "${@:2}" 

EXIT_CODE=$?

# ==============================================================================
# Limpieza
# ==============================================================================
echo "================================================================="
echo " Limpiando directorio de staging..."
rm -rf "${STAGING_DIR}"

if [ $EXIT_CODE -eq 0 ]; then
    echo " Procesamiento completado exitosamente: $(date)"
else
    echo " ERROR: El proceso falló con código ${EXIT_CODE}"
fi
echo "================================================================="

exit $EXIT_CODE
